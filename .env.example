# Web Vitals Profiler sync API (apps/api). Copy to .env for docker compose, or export for `pnpm --filter @wvp/api dev`.

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=8787
# REQUIRED IN PRODUCTION: 32+ characters (signs the extension's sign-in tokens)
JWT_SECRET=
# address browsers use for this API (embeddable badge links)
PUBLIC_URL=http://localhost:8787
LOG_LEVEL=info

# ---------------------------------------------------------------- storage: Firestore
# Firestore is used when FIREBASE_PROJECT_ID or FIREBASE_SERVICE_ACCOUNT is set; otherwise data stays in memory.
FIREBASE_PROJECT_ID=
# service-account JSON on one line (or set GOOGLE_APPLICATION_CREDENTIALS to the key file)
FIREBASE_SERVICE_ACCOUNT=
# local emulator, e.g. 127.0.0.1:8086 (with FIREBASE_PROJECT_ID=demo-wvp)
FIRESTORE_EMULATOR_HOST=

# ---------------------------------------------------------------- Redis (optional: cache, rate limits, alert cool-downs)
REDIS_URL=redis://localhost:6379
# or
# REDIS_HOST=localhost
# REDIS_PORT=6379
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1

# ---------------------------------------------------------------- Lighthouse through PageSpeed Insights
# optional key (higher quota): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# PAGESPEED_API_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed

# ---------------------------------------------------------------- alerts
# e-mail alerts, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Web Vitals Profiler <alerts@example.com>
# seconds between two notifications of the same rule
ALERT_COOLDOWN_SECONDS=900
# allow Slack webhook URLs on private networks (development only; refused in production)
ALLOW_PRIVATE_WEBHOOKS=false

# ---------------------------------------------------------------- Lighthouse CI / scheduled collection (CI only)
# comma-separated pages for lighthouserc.cjs and scripts/collect-vitals.ts
LHCI_URLS=https://example.com
VITALS_URLS=https://example.com
