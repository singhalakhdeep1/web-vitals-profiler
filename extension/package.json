{
  "name": "@wvp/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-targets.mjs",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "preview": "vite preview",
    "build:targets": "node scripts/build-targets.mjs"
  },
  "dependencies": {
    "@wvp/messaging": "workspace:*",
    "@wvp/performance": "workspace:*",
    "@wvp/storage": "workspace:*",
    "@wvp/types": "workspace:*",
    "@wvp/utils": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.2",
    "zustand": "^5.0.3",
    "@wvp/api-client": "workspace:*",
    "@wvp/core": "workspace:*",
    "@wvp/service-worker": "workspace:*",
    "@wvp/wasm": "workspace:*"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.3",
    "@types/chrome": "^0.0.313",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.3",
    "typescript": "5.9.2",
    "vite": "^6.2.3",
    "esbuild": "0.25.12"
  }
}
