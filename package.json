{
  "name": "web-vitals-profiler",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@wvp/extension",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "22",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsx": "4",
    "turbo": "^2.10.3",
    "typescript": "5.9.2",
    "vitest": "^3.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
