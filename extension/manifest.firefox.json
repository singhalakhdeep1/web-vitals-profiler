{
  "$comment": "Overrides applied to the Chrome build for Firefox (scripts/build-targets.mjs): the background module runs as an event page and the side panel becomes a sidebar.",
  "$remove": ["side_panel", "minimum_chrome_version"],
  "$removePermissions": ["sidePanel"],
  "$backgroundScripts": true,
  "sidebar_action": {
    "default_title": "Web Vitals",
    "default_panel": "apps/side-panel/index.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-vitals-profiler@portfolio.dev",
      "strict_min_version": "128.0"
    }
  }
}
