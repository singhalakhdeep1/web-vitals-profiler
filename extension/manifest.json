{
  "manifest_version": 3,
  "name": "Web Vitals Profiler & Performance Monitor",
  "version": "1.0.0",
  "description": "Real-time Core Web Vitals profiling, CLS tracking, and performance analytics.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Vitals Profiler"
  },
  "background": {
    "service_worker": "background.js"
  }
}
